{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "hole",
    "title",
    "visibility",
    "active_character_id",
    "next_user",
    "human_check",
    "why_naive_should_fail"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "hole": { "type": "integer", "minimum": 1, "maximum": 10 },
    "title": { "type": "string", "minLength": 8 },
    "visibility": { "type": "string", "enum": ["public", "held-out"] },
    "active_character_id": { "type": "string", "minLength": 1 },
    "next_user": { "type": "string", "minLength": 8 },
    "human_check": { "type": "string", "minLength": 16 },
    "why_naive_should_fail": { "type": "string", "minLength": 16 }
  }
}
