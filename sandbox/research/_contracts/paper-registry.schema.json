{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["observed_at", "papers"],
  "properties": {
    "observed_at": { "type": "string" },
    "papers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "arxiv",
          "doi",
          "title",
          "band",
          "card_id",
          "holes",
          "assumes_retrieve_equals_remember",
          "steal",
          "why_band",
          "abs"
        ],
        "properties": {
          "arxiv": { "type": "string" },
          "doi": { "type": ["string", "null"] },
          "title": { "type": "string" },
          "band": { "type": "string", "enum": ["core", "adjacent", "out-of-scope"] },
          "card_id": { "type": ["string", "null"] },
          "holes": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1, "maximum": 10 }
          },
          "assumes_retrieve_equals_remember": {
            "type": "string",
            "enum": ["yes", "no", "mixed", "unknown", "n/a"]
          },
          "steal": { "type": "string" },
          "why_band": { "type": "string" },
          "abs": { "type": "string" }
        }
      }
    }
  }
}
