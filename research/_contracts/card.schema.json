{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "kind",
    "repo",
    "docs",
    "license",
    "stars_observed",
    "observed_at",
    "ontology_notes",
    "dimensions",
    "assumes_retrieve_equals_remember",
    "companion_fit",
    "companion_fit_reason",
    "published_eval",
    "sources",
    "open_unknowns"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": [
        "agent-memory-lib",
        "memory-os",
        "temporal-graph",
        "companion-native",
        "roleplay-client",
        "closed-companion-app",
        "mcp-server",
        "eval-benchmark",
        "academic",
        "adjacent-coding-agent"
      ]
    },
    "repo": { "type": ["string", "null"] },
    "docs": { "type": ["string", "null"] },
    "license": { "type": ["string", "null"] },
    "stars_observed": { "type": ["integer", "null"] },
    "observed_at": { "type": "string" },
    "ontology_notes": { "type": "string" },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ontology",
        "write_policy",
        "read_policy",
        "supersession",
        "temporal",
        "identity_split",
        "silence",
        "poisoning",
        "forgetting",
        "cost_shape",
        "local",
        "mcp"
      ],
      "properties": {
        "ontology": { "$ref": "#/$defs/dim" },
        "write_policy": { "$ref": "#/$defs/dim" },
        "read_policy": { "$ref": "#/$defs/dim" },
        "supersession": { "$ref": "#/$defs/dim" },
        "temporal": { "$ref": "#/$defs/dim" },
        "identity_split": { "$ref": "#/$defs/dim" },
        "silence": { "$ref": "#/$defs/dim" },
        "poisoning": { "$ref": "#/$defs/dim" },
        "forgetting": { "$ref": "#/$defs/dim" },
        "cost_shape": { "$ref": "#/$defs/dim" },
        "local": { "$ref": "#/$defs/dim" },
        "mcp": { "$ref": "#/$defs/dim" }
      }
    },
    "assumes_retrieve_equals_remember": {
      "type": "string",
      "enum": ["yes", "no", "mixed", "unknown"]
    },
    "companion_fit": {
      "type": "string",
      "enum": ["FIT", "PARTIAL", "MISFIT"]
    },
    "companion_fit_reason": { "type": "string" },
    "published_eval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "claimed_score", "what_it_actually_scores", "source"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "claimed_score": { "type": ["string", "null"] },
        "what_it_actually_scores": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] }
      }
    },
    "sources": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "open_unknowns": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "dim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "evidence", "label"],
      "properties": {
        "score": {
          "type": "string",
          "enum": ["present", "partial", "absent", "unknown"]
        },
        "evidence": { "type": "string" },
        "label": {
          "type": "string",
          "enum": ["measured", "inferred", "guess"]
        }
      }
    }
  }
}
