# Kiro gateway (required — same as gang.guide pipeline)
KIRO_GATEWAY_URL=http://127.0.0.1:9000
KIRO_GATEWAY_API_KEY=

# Kiro only (no OpenAI key needed)
COMPANMEM_LLM_BACKEND=kiro
COMPANMEM_LLM_MODEL=claude-sonnet-4.6
COMPANMEM_READER_MODEL=claude-sonnet-4.6
COMPANMEM_EXTRACT_MODEL=claude-sonnet-4.6
COMPANMEM_EXTRACT_BACKEND=heuristic
