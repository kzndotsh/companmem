# Companmem pipeline environment. Copy to .env.

# Extract / synthesize (Kiro Messages API)
KIRO_GATEWAY_URL=http://127.0.0.1:9000
KIRO_GATEWAY_API_KEY=
# Fallback if KIRO_GATEWAY_API_KEY is unset:
# PROXY_API_KEY=
# EXTRACT_MODEL=claude-sonnet-4.6
# SYNTHESIZE_MODEL=claude-sonnet-4.6

# Harvest
GITHUB_TOKEN=
# Optional. DuckDuckGo is used when this is empty.
BRAVE_API_KEY=
# Set 0 to silence stderr echo of pipeline JSONL events.
# COMPANMEM_LOG_CONSOLE=1
