# Results — only the published v3 leaderboard reports are tracked.
# Raw scored conversations are large and stay local; so do intermediate
# reliability sweeps and experimental stressor runs, which are not
# leaderboard-comparable and would be mistaken for published results.
results/**/*.json
!results/v3/*_report.json
results/reliability/
results/soc_se/
results/adapt_vs_drift/
results/smoke_test/
results/experimental/
results/ah_slice/
results/sweep/
results/**/*.log
results/*.log

# Archives
*.zip

# Claude Code local config
.claude/

# API keys
.env
.env.*
*.key
