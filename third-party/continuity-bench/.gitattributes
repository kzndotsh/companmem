# The Explorer is verified by SHA-256 against an accepted build. With
# core.autocrlf=true a checkout would rewrite its 1633 LF bytes to CRLF and the
# file would no longer hash to the accepted value. Keep it byte-exact.
docs/index.html -text

# Stressor definitions and published reports are compared and hashed across
# machines; keep their bytes stable too.
*.jsonl -text
results/**/*.json -text
